Bootstrap: docker
From: ubuntu:24.04

%files

%environment
        export LC_ALL=C
        export PATH=$PATH:/usr/local/bin  # Assuming samtools will be installed here
        export PATH=$PATH:/java/jdk-21.0.6/bin
        export PATH=$PATH:/micromamba/bin
        

%post
       
        apt-get -y update \
        && apt-get -y autoremove \
        && apt-get clean \
        && apt-get install -y \
                tabix \
                libcurl4-openssl-dev \
                wget \
                bzip2 \
                lbzip2 \
                build-essential \
                zlib1g-dev \
                libbz2-dev \
                liblzma-dev \
                libncurses-dev \
                libbamtools-dev \
                git-all \
                xxd \
                curl \
                zip \
                && apt-get clean
  
   
        # Get latest STAR source from releases
        wget https://github.com/alexdobin/STAR/archive/2.7.11b.tar.gz
        tar -xzf 2.7.11b.tar.gz
        cd STAR-2.7.11b

        # Compile STAR
        cd source
        make STAR

        #Install GATK
        mkdir /gatk
        cd /gatk
        wget https://github.com/broadinstitute/gatk/releases/download/4.6.1.0/gatk-4.6.1.0.zip
        unzip gatk-4.6.1.0.zip

        #Install picard
        mkdir /picard
        cd /picard
        wget -O picard.jar https://github.com/broadinstitute/picard/releases/download/3.3.0/picard.jar

        # Download and install samtools 1.20
        cd /
        wget https://github.com/samtools/samtools/releases/download/1.20/samtools-1.20.tar.bz2
        tar xvjf samtools-1.20.tar.bz2
        cd samtools-1.20 || exit 1  # Change directory and exit if not found
        ./configure --prefix=/usr/local  # Optional: Set installation prefix
        make
        make install
        cd ..

        #Install Java without SDKMAN
        wget https://download.oracle.com/java/21/latest/jdk-21_linux-x64_bin.tar.gz
        tar xvf jdk-21_linux-x64_bin.tar.gz
        mkdir /java
        mv jdk-21.0.6 /java
        export PATH="/java/jdk-21.0.6/bin:$PATH"
        
        

        cd /                       
        #Install perl                             
        curl -L http://xrl.us/installperlnix | bash

      
        #Download vep repo
        cd /
        git clone https://github.com/Ensembl/ensembl-vep.git
        

        cd /
        wget https://github.com/mskcc/vcf2maf/archive/refs/tags/v1.6.22.tar.gz
        tar xvf v1.6.22.tar.gz
    
        #Install vep and vcf2maf dependencies
        apt-get install -y libhts-dev
        apt install -y cpanminus
        cpan -i LWP::Simple
        cpan -i DBI
        cpan -i Archive::Zip

        # install VEP #
        mkdir /.vep
        cd /ensembl-vep
        perl INSTALL.pl --AUTO acfp --ASSEMBLY GRCh38 --PLUGINS all --SPECIES homo_sapiens,mus_musculus --CACHEDIR /.vep
        
    

%runscript
    
